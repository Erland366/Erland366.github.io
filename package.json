{
  "name": "erland-research-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/clean-output.mjs && eleventy",
    "dev": "eleventy --serve --port=8080",
